# Copy this to .env and fill in your values

# For local development
MONGODB_URI=mongodb://localhost:27017/journal

# For production (use on hosting platform)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/journal

PORT=5000
NODE_ENV=development

# JWT Secrets (use strong, unique secrets in production)
JWT_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
